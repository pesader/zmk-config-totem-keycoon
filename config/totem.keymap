//
//                                                        ▀▀▀▀▀     ▀▀▀▀▀          ▀▀█▀▀
//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <locale/keys_pt_abnt2.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt {
    flavor = "balanced";
    tapping-term-ms = <300>;
    quick-tap-ms = <250>;
    require-prior-idle-ms = <50>;
};

&sk { quick-release; };

/ {
    behaviors {
        shift_bspc_del: shift_bspc_del {
            compatible = "zmk,behavior-mod-morph";
            label = "SHIFT_BSPC_DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lt_bspc_r: lt_bspc_r {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_BSPC_R";
            bindings = <&mo>, <&shift_bspc_del>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
            hold-trigger-key-positions = <10 11 12 13 21 22 23 24 16 17 18 19 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34>;
        };

        hrm_l: homerow_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
            hold-trigger-key-positions = <31 9 19 30 8 18 29 7 17 28 6 16 27 5 15 26 37 36 35 13 12 11 10 32 34 33>;
        };

        hrm_r: homerow_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34 34 16 17 18 19 35 36 37>;
        };

        hrm_l_hwu: homerow_mod_left_hwu {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_LEFT_HWU";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
            hold-trigger-key-positions = <31 9 19 30 8 18 29 7 17 28 6 16 27 5 15 26 37 36 35 13 12 11 10 32 33 34>;
        };

        hrm_r_hwu: homerow_mod_right_hwu {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_RIGHT_HWU";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34 34 35 36 37 16 17 18 19>;
        };

        sl_mo_l: sticky_layer_momentary_layer_l {
            compatible = "zmk,behavior-hold-tap";
            label = "STICKY_LAYER_MOMENTARY_LAYER_L";
            bindings = <&mo>, <&sl>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
            hold-trigger-key-positions = <35 36 37 5 15 26 6 16 27 7 17 28 8 18 29 9 19 30 31 13 12 11 10 32 33 34>;
        };

        sl_mo_r: sticky_layer_momentary_layer_r {
            compatible = "zmk,behavior-hold-tap";
            label = "STICK_LAYER_MOMENTARY_LAYER_R";
            bindings = <&mo>, <&sl>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
            hold-trigger-key-positions = <13 12 11 10 32 33 34 0 1 2 3 4 10 11 12 13 14 20 22 23 24 25 21 35 36 37 16 17 18 19>;
        };

        sk_mo_l: stick_key_momentary_layer_l {
            compatible = "zmk,behavior-hold-tap";
            label = "STICKY_KEY_MOMENTARY_LAYER_L";
            bindings = <&mo>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
            hold-trigger-key-positions = <10 11 12 13 32 33 34 10 11 12 13 14 32 33 35 36 37 16 17 18 19 5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37>;
        };

        sk_mo_r: sticky_key_momentary_layer_r {
            compatible = "zmk,behavior-hold-tap";
            label = "STICKY_KEY_MOMENTARY_LAYER_R";
            bindings = <&mo>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
            hold-trigger-key-positions = <10 11 12 13 32 33 34 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 35 36 37 16 17 18 19>;
        };

        // ==========================================
        // SINGLE-TAP SMART KEYS (Hold-Tap Only)
        // ==========================================

        sm_dot: smart_dot {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            bindings = <&mac_dot_sft &kp>;
        };
        sm_comma: smart_comma {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            bindings = <&mac_comma_spc &kp>;
        };
        sm_qmark: smart_qmark {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            bindings = <&mac_qmark_sft &kp>;
        };
        sm_excl: smart_excl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            bindings = <&mac_excl_sft &kp>;
        };
        sm_star: smart_star {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            bindings = <&mac_star_spc &kp>;
        };
        sm_fslh: smart_fslh {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            bindings = <&mac_fslh_spc &kp>;
        };
        sm_prcnt: smart_prcnt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            bindings = <&mac_prcnt_spc &kp>;
        };
        sm_dllr: smart_dllr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            bindings = <&mac_brl_spc &kp>;
        };

        // ==========================================
        // MULTI-TAP SMART KEYS (Nested Tap-Dance)
        // ==========================================

        // Smart Equal
        ht_eq_1: ht_eq_1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>; tapping-term-ms = <250>; flavor = "tap-preferred";
            bindings = <&mac_eq_spc &kp>;
        };
        ht_eq_2: ht_eq_2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>; tapping-term-ms = <250>; flavor = "tap-preferred";
            bindings = <&mac_neq_spc &mac_eqeq_spc>;
        };
        sm_eq: smart_equal {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>; tapping-term-ms = <250>;
            bindings = <&ht_eq_1 0 PT_EQUAL>, <&ht_eq_2 0 0>;
        };

        // Smart Greater Than
        ht_gt_1: ht_gt_1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>; tapping-term-ms = <250>; flavor = "tap-preferred";
            bindings = <&mac_gt_spc &kp>;
        };
        ht_gt_2: ht_gt_2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>; tapping-term-ms = <250>; flavor = "tap-preferred";
            bindings = <&mac_gte_spc &mac_gtgt>;
        };
        sm_gt: smart_gt {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>; tapping-term-ms = <250>;
            bindings = <&ht_gt_1 0 GT>, <&ht_gt_2 0 0>;
        };

        // Smart Less Than
        ht_lt_1: ht_lt_1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>; tapping-term-ms = <250>; flavor = "tap-preferred";
            bindings = <&mac_lt_spc &kp>;
        };
        ht_lt_2: ht_lt_2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>; tapping-term-ms = <250>; flavor = "tap-preferred";
            bindings = <&mac_lte_spc &mac_ltlt>;
        };
        sm_lt: smart_lt {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>; tapping-term-ms = <250>;
            bindings = <&ht_lt_1 0 LT>, <&ht_lt_2 0 0>;
        };

        // Smart Plus
        ht_plus_1: ht_plus_1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>; tapping-term-ms = <250>; flavor = "tap-preferred";
            bindings = <&mac_plus_spc &kp>;
        };
        ht_plus_2: ht_plus_2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>; tapping-term-ms = <250>; flavor = "tap-preferred";
            bindings = <&mac_plus_eq_spc &mac_plusplus_spc>;
        };
        sm_plus: smart_plus {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>; tapping-term-ms = <250>;
            bindings = <&ht_plus_1 0 PLUS>, <&ht_plus_2 0 0>;
        };

        // Smart Minus
        ht_minus_1: ht_minus_1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>; tapping-term-ms = <250>; flavor = "tap-preferred";
            bindings = <&mac_minus_spc &kp>;
        };
        ht_minus_2: ht_minus_2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>; tapping-term-ms = <250>; flavor = "tap-preferred";
            bindings = <&mac_minus_eq_spc &mac_mimi_spc>;
        };
        sm_minus: smart_minus {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>; tapping-term-ms = <250>;
            bindings = <&ht_minus_1 0 MINUS>, <&ht_minus_2 0 0>;
        };
    };

    macros {
        os_focus_notification: os_dismiss_notification {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(R)>;
            label = "OS_DISMISS_NOTIFICATION";
        };

        os_end_session: os_end_session {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(DELETE))>;
            label = "OS_END_SESSION";
        };

        os_lock_screen: os_lock_screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(BACKSPACE))>;
            label = "OS_LOCK_SCREEN";
        };

        txt_assignment: txt_assignment {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PT_SPACE &kp PT_EQUAL &kp PT_SPACE>;
            label = "TXT_ASSIGNMENT";
        };

        txt_equals: txt_equals {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PT_SPACE &kp PT_EQUAL &kp PT_EQUAL &kp PT_SPACE>;
            label = "TXT_EQUALS";
        };

        txt_nequals: txt_nequals {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PT_SPACE &kp PT_EXCL &kp PT_EQUAL &kp PT_SPACE>;
            label = "TXT_NEQUALS";
        };

        // Simple Punctuation Holds
        mac_dot_sft: mac_dot_sft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOT &kp SPACE &sk LEFT_SHIFT>;
        };
        mac_comma_spc: mac_comma_spc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COMMA &kp SPACE>;
        };
        mac_qmark_sft: mac_qmark_sft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp QMARK &kp SPACE &sk LEFT_SHIFT>;
        };
        mac_excl_sft: mac_excl_sft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EXCL &kp SPACE &sk LEFT_SHIFT>;
        };
        mac_star_spc: mac_star_spc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp STAR &kp SPACE>;
        };
        mac_fslh_spc: mac_fslh_spc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp PT_FSLH &kp SPACE>;
        };
        mac_prcnt_spc: mac_prcnt_spc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PRCNT &kp SPACE>;
        };
        mac_brl_spc: mac_brl_spc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp DLLR &kp SPACE>;
        };

        // Multi-Tap Math/Logic Holds
        mac_eq_spc: mac_eq_spc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp PT_EQUAL &kp SPACE>;
        };
        mac_eqeq_spc: mac_eqeq_spc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp PT_EQUAL &kp PT_EQUAL &kp SPACE>;
        };
        mac_neq_spc: mac_neq_spc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp EXCL &kp PT_EQUAL &kp SPACE>;
        };

        mac_gt_spc: mac_gt_spc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp GT &kp SPACE>;
        };
        mac_gtgt: mac_gtgt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GT &kp GT>;
        };
        mac_gte_spc: mac_gte_spc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp GT &kp PT_EQUAL &kp SPACE>;
        };

        mac_lt_spc: mac_lt_spc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp LT &kp SPACE>;
        };
        mac_ltlt: mac_ltlt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LT &kp LT>;
        };
        mac_lte_spc: mac_lte_spc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp LT &kp PT_EQUAL &kp SPACE>;
        };

        mac_plus_spc: mac_plus_spc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp PLUS &kp SPACE>;
        };
        mac_plusplus_spc: mac_plusplus_spc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PLUS &kp PLUS &kp SPACE>;
        };
        mac_plus_eq_spc: mac_plus_eq_spc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp PLUS &kp PT_EQUAL &kp SPACE>;
        };

        mac_minus_spc: mac_minus_spc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp MINUS &kp SPACE>;
        };
        mac_mimi_spc: mac_mimi_spc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp MINUS &kp SPACE>;
        };
        mac_minus_eq_spc: mac_minus_eq_spc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp MINUS &kp PT_EQUAL &kp SPACE>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_super {
            bindings = <&kp ENTER>;
            key-positions = <13 12>;
        };

        right_esc {
            bindings = <&kp ESC>;
            key-positions = <16 17>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
        &kp Q          &kp W              &kp E           &kp R                &kp T                     &kp Y                   &kp U                &kp I                  &kp O              &kp P
        &hrm_l LGUI A  &hrm_l LEFT_ALT S  &hrm_l LCTRL D  &hrm_l LEFT_SHIFT F  &hrm_l LA(LG(LCTRL)) G    &hrm_r LA(LG(LCTRL)) H  &hrm_r LEFT_SHIFT J  &hrm_r LEFT_CONTROL K  &hrm_r LEFT_ALT L  &hrm_r LGUI PT_SEMI
&kp AT  &kp Z          &kp X              &kp C           &kp V                &kp B                     &kp N                   &kp M                &sm_comma 0 COMMA      &sm_dot 0 DOT      &sm_fslh 0 PT_FSLH   &sm_excl 0 EXCL
                                          &sl_mo_l 5 7    &lt 1 SPACE          &lt 3 TAB                 &sk_mo_r 4 LEFT_SHIFT   &lt_bspc_r 2 0       &sl_mo_r 6 7
            >;
        };

        navigation {
            bindings = <
                &kp LC(N0)            &kp LC(MINUS)            &kp LC(PLUS)                   &kp LC(EQUAL)          &none    &os_focus_notification  &kp LG(NUMBER_1)        &kp LG(N2)              &kp LG(N3)             &kp LG(NUMBER_4)
                &hrm_l LEFT_GUI HOME  &hrm_l LEFT_ALT PAGE_UP  &hrm_l LEFT_CONTROL PAGE_DOWN  &hrm_l LEFT_SHIFT END  &none    &kp LEFT_ARROW          &hrm_r LEFT_SHIFT DOWN  &hrm_r LEFT_CONTROL UP  &hrm_r LEFT_ALT RIGHT  &hrm_r LEFT_GUI PRINTSCREEN
&studio_unlock  &none                 &none                    &none                          &none                  &none    &kp CAPSLOCK            &kp LC(TAB)             &kp LA(TAB)             &kp LG(TAB)            &kp LG(ESC)                  &os_end_session
                                                               &none                          &none                  &none    &none                   &kp K_MENU              &caps_word
            >;
        };

        symbols {
            bindings = <
             &kp DLLR              &kp PRCNT         &kp PT_LBRC       &kp PT_RBRC  &kp AMPS       &none  &none         &none        &none  &none
             &kp LS(RA(PT_ACUTE))  &kp PT_DQT        &kp LPAR          &kp RPAR     &kp HASH       &none  &kp PT_COLON  &kp PT_FSLH  &none  &none
&kp PT_BSLH  &kp LS(RA(PT_TILDE))  &kp RA(PT_TILDE)  &kp PT_LBKT       &kp PT_RBKT  &kp PT_PIPE    &none  &none         &none        &none  &none  &none
                                                     &kp RA(PT_ACUTE)  &kp UNDER    &kp PT_SQT     &none  &none         &none
            >;
        };

        numbers {
            bindings = <
       &none                    &none                 &none                      &none                   &none    &sm_plus   &kp N1                &kp N2                  &kp N3              &kp COMMA
       &hrm_l LEFT_GUI PT_FSLH  &hrm_l LEFT_ALT STAR  &hrm_l LEFT_CONTROL MINUS  &hrm_l LEFT_SHIFT PLUS  &none    &sm_minus  &hrm_r LEFT_SHIFT N4  &hrm_r LEFT_CONTROL N5  &hrm_r LEFT_ALT N6  &hrm_r LEFT_GUI DOT
&none  &none                    &none                 &none                      &none                   &none    &sm_star 0 STAR &kp N7           &kp N8                  &kp N9              &sm_fslh 0 PT_FSLH   &kp UNDER
                                                      &none                      &none                   &none    &sm_eq     &kp N0                &none
            >;
        };

        media {
            bindings = <
            &kp C_REWIND  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_FAST_FORWARD  &none           &none  &none  &none  &none  &none
            &kp C_PREV    &kp C_VOL_DN          &kp C_VOLUME_UP       &kp C_NEXT          &none           &none  &none  &none  &none  &none
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1          &bt BT_SEL 2          &bt BT_SEL 3        &bt BT_SEL 4    &none  &none  &none  &none  &none  &studio_unlock
                                                &kp C_STOP            &kp C_PLAY_PAUSE    &kp K_MUTE      &none  &none  &none
            >;
        };

        function {
            bindings = <
       &none         &none         &none             &none           &none    &none  &kp F1  &kp F2  &kp F3  &kp F10
       &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none    &none  &kp F4  &kp F5  &kp F6  &kp F11
&none  &none         &none         &none             &none           &none    &none  &kp F7  &kp F8  &kp F9  &kp F12  &none
                                   &none             &none           &none    &none  &none   &none
            >;
        };

        launchers {
            bindings = <
       &none       &none       &none       &none       &none    &none  &none  &none  &none  &none
       &kp LG(N4)  &kp LG(N3)  &kp LG(N2)  &kp LG(N1)  &none    &none  &none  &none  &none  &none
&none  &none       &none       &none       &none       &none    &none  &none  &none  &none  &none  &none
                               &none       &kp LG(N5)  &none    &none  &none  &none
            >;
        };

        accents {
            bindings = <
       &none         &none         &none             &none         &none    &none  &none         &none         &none         &none
       &kp PT_GRAVE  &kp PT_CARET  &kp PT_TILDE      &kp PT_ACUTE  &none    &none  &kp PT_ACUTE  &kp PT_TILDE  &kp PT_CARET  &kp PT_GRAVE
&none  &none         &none         &kp PT_C_CEDILLA  &none         &none    &none  &none         &none         &none         &none         &none
                                   &none             &none         &none    &none  &none         &none
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
